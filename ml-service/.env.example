# Shared project settings
PROJECT_NAME=AI-Driven Multimodal Coconut Plantation Risk Assessment
DATA_ROOT=data/
ARTIFACTS_DIR=artifacts/
REPORTS_DIR=reports/
LOG_LEVEL=INFO

# PostgreSQL (same database the Express server uses)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coconut_research

# ML API (FastAPI)
ML_API_PORT=8000

# Optional model registry settings
MLFLOW_TRACKING_URI=http://localhost:5001
